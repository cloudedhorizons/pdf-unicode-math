\cs_new:Npn \pum_declare_latin:nN #1#2{
	\seq_map_inline:Nn \c_pum_latin_seq {
		\cs_new:cpn {#1 ##1} {#2 {##1}}
	}
	\seq_map_inline:Nn \c_pum_Latin_seq {
		\cs_new:cpn {#1 ##1} {#2 {##1}}
	}
}

\cs_new:Npn \pum_declare_greek:nN #1#2{
	\seq_map_inline:Nn \c_pum_greek_seq {
		\cs_new:cpn {#1 ##1} {#2 {\cs:w ##1\cs_end:}}
	}
}
\cs_new:Npn \pum_declare_Greek:nN #1#2{
	\seq_map_inline:Nn \c_pum_Greek_seq {
		\cs_new:cpn {#1 ##1} {#2 {\cs:w ##1\cs_end:}}
	}
}

\cs_new:Npn \pum_declare_numbers:nN #1 #2 {
	\cs_new:cpn {#1 zero} {#2 {0}}
	\seq_map_indexed_inline:Nn \c_pum_numbers_seq {\cs_new:cpn {#1 ##2} {#2 {##1}}}
}

\cs_new:Npn \pum_declare_all:nN#1#2{
	\pum_declare_latin:nN {#1}{#2}
	\pum_declare_greek:nN {#1}{#2}
	\pum_declare_Greek:nN {#1}{#2}
}


