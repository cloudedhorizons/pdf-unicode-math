%!TEX root=pdf-unicode-math-test.tex
% !TEX program=pdflatex
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{pdf-unicode-math}{2026/11/02}{1.0}{Declare unicode characters in math for pdflatex}


\bool_new:N \g_pum_textoverride_bool
\bool_new:N \g_pum_textmultidef_bool
\bool_gset_true:N \g_pum_textoverride_bool
\bool_gset_true:N \g_pum_textmultidef_bool

%
%
\keys_define:nn {pdf-unicode-math} {
	Greek .bool_set:N = \g_pum_Greek_bool,
	textcommands .choice:,
	textcommands / none .code:n = {\bool_gset_false:N \g_pum_textoverride_bool},
	textcommands / override .code:n = {\bool_gset_true:N \g_pum_textoverride_bool
		\bool_gset_false:N \g_pum_textmultidef_bool},
	textcommands / multidef .code:n = {\bool_gset_true:N \g_pum_textoverride_bool
		\bool_gset_true:N \g_pum_textmultidef_bool}
	
}

\ProcessKeyOptions[pdf-unicode-math]

\msg_new:nnn {pdf-unicode-math} {defining} {PUM: ~ Defining ~ U+\hex_strip:w #1 ~ as ~ #2.}
\msg_new:nnn {pdf-unicode-math} {csundefined} {PUM: ~ #2 ~ is ~ undefined; ~ skipping ~ U+\hex_strip:w #1. }
\msg_new:nnn {pdf-unicode-math} {defined-overriding} {PUM: ~ U+\hex_strip:w #1 ~ is ~ already defined; ~ overriding ~ to ~ #2.}
\msg_new:nnn {pdf-unicode-math} {defined-multiple} {PUM: ~ U+\hex_strip:w #1 ~ is ~ already defined; ~ giving ~ secondary ~ definition ~ #2.}
\msg_new:nnn {pdf-unicode-math} {defined-skipping} {PUM: ~ U+\hex_strip:w #1 ~ is ~ already ~ defined; ~ skipping #2.}
\msg_new:nnn {pdf-unicode-math} {redundant}{PUM: Skipping ~ redundant ~ definition ~ #2 ~ for ~ U+\hex_strip:w #1.}



\cs_new:Npn \pum_if_defined_unicode:nTF#1#2#3{
	\cs_if_exist:cTF{u8: \codepoint_str_generate:n{#1}}{#2}{#3}
}

\cs_new:Npn \pum_meaning_codepoint:n #1 {
	\cs_meaning:c {u8: \codepoint_str_generate:n{#1}}
}

\cs_new_eq:NN \MeaningCodepoint \pum_meaning_codepoint:n


\cs_new:Npn \pum_meaning_char:n #1 {
	\cs_meaning:c {u8: \tl_to_str:n{#1}}
}

\cs_new_eq:NN \MeaningChar \pum_meaning_char:n


\cs_new:Npn \pum_redefine:nn #1 #2 {
	\tl_set:Nv \l_tmpa_tl {u8 : \codepoint_str_generate:n{#1}}
	\cs_gset_nopar:cpe{u8 : \codepoint_str_generate:n{#1}}{\exp_not:N\ifmmode \exp_not:n {#2} \exp_not:N\else \exp_not:V \l_tmpa_tl \exp_not:N\fi}
}

\cs_new:Npn \pum_define:nn #1 #2 {
	\cs_gset_nopar:cpn{u8 : \codepoint_str_generate:n{#1}}{#2}
}


