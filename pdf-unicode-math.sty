\seq_new:N \g_pum_definedcodepoints_seq

\cs_new:Npn \UnicodeMathSymbol #1#2#3#4 {
	\int_compare:nNnT {#1} > {"7F} {
		\cs_if_exist:NTF #2 {
			\pum_if_defined_unicode:nTF {#1} {
				\seq_if_in:NnTF \g_pum_definedcodepoints_seq {#1} {
					\msg_log:nnnn {pdf-unicode-math}{redundant}{#1}{#2}
				}{
					\seq_gpush:Nn \g_pum_definedcodepoints_seq {#1}
					\bool_if:NTF \g_pum_textoverride_bool {
						\bool_if:NTF \g_pum_textmultidef_bool {
							\msg_log:nnnn {pdf-unicode-math}{defined-multiple}{#1}{#2}
							\pum_redefine:nn {#1}{#2}
						} {
							\msg_log:nnnn {pdf-unicode-math}{defined-overriding}{#1}{#2}
							\pum_define:nn {#1}{#2}
						}
					} {
						\msg_log:nnnn {pdf-unicode-math}{defined-skipping}{#1}{#2}
					}
				}
			} {
				\seq_gpush:Nn \g_pum_definedcodepoints_seq {#1}
				\msg_log:nnnn {pdf-unicode-math}{defining}{#1}{#2}
				\pum_define:nn {#1} {#2}
			}
		} {\msg_log:nnnn{pdf-unicode-math}{csundefined}{#1}{#2}}
	}
}
